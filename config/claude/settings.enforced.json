{
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(sudo rm:*)",
      "Bash(npm publish:*)",
      "Bash(yarn publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(npx vercel:*)",
      "Bash(vercel:*)",
      "Bash(netlify:*)",
      "Bash(npx netlify:*)",
      "Bash(docker push:*)",
      "Bash(gh release:*)",
      "Bash(prisma migrate deploy:*)",
      "Bash(npx prisma migrate deploy:*)",
      "Bash(alembic upgrade:*)",
      "Bash(rails db:migrate:*)",
      "Bash(bundle exec rails db:migrate:*)",
      "Bash(sudo:*)",
      "Bash(apt:*)",
      "Bash(apt-get:*)",
      "Bash(npm install -g:*)",
      "Bash(npm i -g:*)",
      "Bash(pnpm add -g:*)",
      "Bash(yarn global add:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 60
  }
}
